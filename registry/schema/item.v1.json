{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevko.jhonata.dev/registry/schema/item.v1.json",
  "title": "Aevko registry item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "title",
    "description",
    "category",
    "angular",
    "files",
    "registryDependencies",
    "npmDependencies"
  ],
  "properties": {
    "$schema": {
      "const": "https://aevko.jhonata.dev/registry/schema/item.v1.json"
    },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "actions",
        "content",
        "data",
        "feedback",
        "forms",
        "layout",
        "navigation",
        "overlays"
      ]
    },
    "angular": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": { "$ref": "#/$defs/relativePath" },
              "target": { "$ref": "#/$defs/relativePath" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "content"],
            "properties": {
              "target": { "$ref": "#/$defs/relativePath" },
              "content": { "type": "string" }
            }
          }
        ]
      }
    },
    "registryDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "npmDependencies": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "integrity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
